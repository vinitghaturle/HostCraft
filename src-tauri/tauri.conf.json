{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostCraft",
  "version": "0.1.0",
  "identifier": "com.hostcraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HostCraft",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/playit"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vinitghaturle/HostCraft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxNkQ5NkY1QzlCMjY3NEYKUldSUFo3TEo5Wlp0UWVuS2xqaElhM1R4MThhSWgrYjZaSlUxVkdvY0x5NjBsY3o0NGZ6WS93V2YK"
    }
  }
}
